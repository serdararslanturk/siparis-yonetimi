{
  "_ACIKLAMA": "Bu bir ŞABLONDUR. Kopyalayıp 'appsettings.Production.json' yapın ve [...] yerlerini doldurun. Gerçek dosya .gitignore ile GitHub'dan gizlenir.",
  "ConnectionStrings": {
    "FiloDb": "Server=.;Database=AcrFilo;Integrated Security=true;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=False;Connect Timeout=15"
  },
  "Jwt": {
    "Issuer": "acr-filo",
    "Audience": "acr-filo-web",
    "SigningKey": "[BURAYA_EN_AZ_32_KARAKTERLIK_RASTGELE_ANAHTAR]",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Security": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 12
  },
  "Cors": { "AllowedOrigins": [] },
  "Serilog": {
    "MinimumLevel": { "Default": "Warning", "Override": { "Acr.Filo": "Information" } },
    "WriteTo": [ { "Name": "File", "Args": { "path": "logs/filo-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } } ]
  },
  "Swagger": { "Enabled": false }
}
